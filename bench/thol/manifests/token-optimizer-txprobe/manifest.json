{
  "name": "token-optimizer-txprobe",
  "display_name": "Token Optimizer (probe: proxy in the path, no proxy env var)",
  "verified": true,
  "version_pin": "6.0.2",
  "version_checked": "2026-09-10",
  "upstream": "https://github.com/ooples/token-optimizer-mcp",
  "install_doc": "ISOLATES THE PROXY BEING IN THE PATH FROM TOKEN_OPTIMIZER_PROXY BEING SET. The proxy arm sends a request 46% larger than the assist arm -- 29,824 prefix tokens against 20,431 -- for reasons a local byte-identity test could not reproduce: with the proxy in the path the forwarded body was identical to the direct one in all 226,381 bytes bar the session UUID.\n\nTwo differences remain between the arms: the client env carries TOKEN_OPTIMIZER_PROXY=1, and our proxy is in the path. This arm keeps the second and drops the first, and it routes through the same proxy so the ledger measures its composition with the same instrument.",
  "requires": [
    "node"
  ],
  "settings": {
    "env": {
      "TOKEN_OPTIMIZER_REFRESH_INTERVAL_MS": "999999999999",
      "TOKEN_OPTIMIZER_RUNTIME": "/opt/token-optimizer-runtime",
      "TOKEN_OPTIMIZER_MODE": "assist",
      "TOKEN_OPTIMIZER_MCP_CAPABILITIES": "",
      "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787"
    },
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"/usr/local/lib/node_modules/@ooples/token-optimizer-mcp/plugin/hooks/session-start.mjs\""
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Read|Grep|Glob|Edit|MultiEdit|Write|Bash|PowerShell",
          "hooks": [
            {
              "type": "command",
              "command": "node \"/usr/local/lib/node_modules/@ooples/token-optimizer-mcp/plugin/hooks/pretooluse-router.mjs\""
            }
          ]
        }
      ],
      "PreCompact": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"/usr/local/lib/node_modules/@ooples/token-optimizer-mcp/plugin/hooks/precompact-optimize.mjs\""
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|MultiEdit|Write|Bash|PowerShell|mcp__.*__(?:smart_edit|smart_write)",
          "hooks": [
            {
              "type": "command",
              "command": "node \"/usr/local/lib/node_modules/@ooples/token-optimizer-mcp/plugin/hooks/post-tool.mjs\""
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"/usr/local/lib/node_modules/@ooples/token-optimizer-mcp/plugin/hooks/stop.mjs\""
            }
          ]
        }
      ]
    }
  },
  "tool_prefixes": [
    "mcp__token-optimizer__"
  ]
}
