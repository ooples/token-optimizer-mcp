# A pinned environment file. No real credential appears here: every value is a
# placeholder, so the fixture can live in a public repository unchanged.
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://user:PLACEHOLDER@localhost:5432/example
REDIS_URL=redis://localhost:6379/0
FEATURE_ROLLOUT_CHANNEL=stable
REQUEST_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=10485760