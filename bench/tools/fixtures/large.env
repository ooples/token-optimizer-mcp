# A pinned environment file at the size a deployed service actually carries. No
# real credential appears here: every value is a placeholder, so the fixture can
# live in a public repository unchanged. It exists because example.env is the
# smallest .env anyone would write, and a tool measured only against the
# smallest input publishes its worst case as its whole range.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=json
SERVICE_NAME=example-api
SERVICE_VERSION=4.12.0
DEPLOY_REGION=us-east-1
DEPLOY_STAGE=prod
DATABASE_URL=postgres://user:PLACEHOLDER@db.internal:5432/example
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=require
DATABASE_STATEMENT_TIMEOUT_MS=15000
READ_REPLICA_URL=postgres://user:PLACEHOLDER@replica.internal:5432/example
REDIS_URL=redis://cache.internal:6379/0
REDIS_TLS=true
REDIS_KEY_PREFIX=example:prod:
SESSION_SECRET=PLACEHOLDER
JWT_ISSUER=https://auth.example.test
JWT_AUDIENCE=example-api
JWT_PUBLIC_KEY_URL=https://auth.example.test/.well-known/jwks.json
OAUTH_CLIENT_ID=PLACEHOLDER
OAUTH_CLIENT_SECRET=PLACEHOLDER
OAUTH_REDIRECT_URI=https://app.example.test/callback
S3_BUCKET=example-prod-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=PLACEHOLDER
AWS_SECRET_ACCESS_KEY=PLACEHOLDER
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USERNAME=PLACEHOLDER
SMTP_PASSWORD=PLACEHOLDER
MAIL_FROM=no-reply@example.test
STRIPE_SECRET_KEY=PLACEHOLDER
STRIPE_WEBHOOK_SECRET=PLACEHOLDER
SENTRY_DSN=https://PLACEHOLDER@sentry.example.test/1
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.internal:4318
METRICS_PORT=9090
FEATURE_ROLLOUT_CHANNEL=stable
FEATURE_NEW_CHECKOUT=false
FEATURE_ASYNC_EXPORT=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
REQUEST_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=10485760
CORS_ALLOWED_ORIGINS=https://app.example.test,https://admin.example.test
TRUST_PROXY=1