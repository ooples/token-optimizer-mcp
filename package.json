    "format:check": "prettier --check 'src/**/*.{ts,js,json}' '!src/{hooks-core,plugin,integrations,scripts,ucr,schemas,evals}/**'",
    "validate": "node src/scripts/validate-package.js",
    "verify:package-contents": "node src/scripts/verify-package-contents.mjs",
    "verify:published-launch": "node src/scripts/verify-published-launch.mjs",
    "sync:hooks": "node src/scripts/sync-hook-core.mjs && node src/scripts/generate-client-entries.mjs && node src/scripts/generate-opencode-legacy-plugin.mjs && node src/scripts/generate-client-configs.mjs && node src/scripts/pin-mcp-version.mjs",
    "sync:hooks:check": "node src/scripts/sync-hook-core.mjs --check && node src/scripts/generate-client-entries.mjs --check && node src/scripts/generate-opencode-legacy-plugin.mjs --check && node src/scripts/generate-client-configs.mjs --check && node src/scripts/pin-mcp-version.mjs --check",
    "stamp:version": "node src/scripts/sync-hook-core.mjs --stamp && node src/scripts/generate-client-entries.mjs --stamp",
    "stamp:telemetry": "node src/scripts/stamp-telemetry-key.mjs",
    "verify:ui": "node src/scripts/verify-wiki-ui.mjs",
    "evidence:orcarouter": "node src/scripts/capture-orcarouter-evidence.mjs",
    "evidence:orcarouter-live": "node src/scripts/verify-orcarouter-live.mjs",
    "verify:harvest": "node src/scripts/verify-harvest-api.mjs",
    "verify:live-graph": "node src/scripts/verify-live-graph-flow.mjs",
    "verify:clients": "node src/scripts/verify-client-configs.mjs",
    "verify:certification": "node src/scripts/certify-clients.mjs --no-version-check",
    "verify:ucr": "node src/scripts/verify-ucr-runtime.mjs",
    "verify:ucr:study-design": "node src/scripts/verify-ucr-study-readiness.mjs",
    "eval:ucr:qualification:verify": "node src/scripts/verify-ucr-qualification.mjs",
    "eval:ucr:qualification:gate": "node src/scripts/verify-ucr-qualification.mjs --require-qualified",
    "evidence:ucr:study-design:update": "node src/scripts/verify-ucr-study-readiness.mjs --write",
    "evidence:ucr:update": "node src/scripts/verify-ucr-runtime.mjs --write",
    "eval:ucr:handoff:plan": "node src/scripts/run-ucr-handoff-smoke.mjs",
    "eval:ucr:handoff": "node src/scripts/run-ucr-handoff-smoke.mjs --execute",
    "eval:ucr:scale": "node src/scripts/run-ucr-scale.mjs",
    "eval:ucr:coordination": "node src/scripts/run-ucr-coordination-scale.mjs",
    "eval:ucr:consolidation": "node src/scripts/run-ucr-consolidation-study.mjs",
    "eval:ucr:adapters": "node src/scripts/run-ucr-adapter-certification.mjs --write",
    "eval:ucr:compounding": "node src/scripts/run-ucr-compounding-study.mjs",
    "eval:ucr:production": "node src/scripts/run-ucr-production-study.mjs",
    "eval:ucr:production:traffic:plan": "node src/scripts/assemble-ucr-production-traffic.mjs",
    "eval:ucr:production:traffic": "node src/scripts/assemble-ucr-production-traffic.mjs --execute",
    "eval:ucr:context": "node src/scripts/run-mcp-context-audit.mjs",
    "evidence:ucr:assemble": "node src/scripts/assemble-ucr-evidence.mjs && node src/scripts/verify-ucr-runtime.mjs --write",
    "eval:ucr:multimodel:plan": "node src/scripts/run-ucr-multimodel-handoff.mjs",
    "eval:ucr:multimodel": "node src/scripts/run-ucr-multimodel-handoff.mjs --execute --directions all",
    "eval:ucr:effectiveness:plan": "node src/scripts/run-ucr-handoff-effectiveness.mjs",
    "eval:ucr:effectiveness": "node src/scripts/run-ucr-handoff-effectiveness.mjs --execute --pairs-per-direction 357",
    "eval:ucr:full-study:plan": "node src/scripts/run-ucr-full-study.mjs",
    "eval:ucr:full-study:powered-plan": "node src/scripts/run-ucr-full-study.mjs --powered",
    "eval:ucr:identity:provision": "node src/scripts/provision-ucr-study-identity.mjs",
    "eval:ucr:full-study:qualification": "node src/scripts/run-ucr-full-study.mjs --execute --runner-module src/scripts/ucr-study-driver-dispatch.mjs",
    "eval:ucr:full-study": "node src/scripts/run-ucr-full-study.mjs --execute --powered --runner-module src/scripts/ucr-study-driver-dispatch.mjs",
    "eval:ucr:competitive:plan": "node src/scripts/run-ucr-competitive-study.mjs",
    "eval:ucr:competitive": "node src/scripts/run-ucr-competitive-study.mjs --execute",
    "eval:evidence": "node src/scripts/run-evidence-eval.mjs",
    "eval:evidence:plan": "node src/scripts/run-evidence-eval.mjs --dry-run",
    "eval:handoff": "node src/scripts/run-handoff-eval.mjs",
    "eval:handoff:plan": "node src/scripts/run-handoff-eval.mjs --dry-run",
    "eval:handoff:concurrent": "node src/scripts/run-concurrent-handoff-eval.mjs",
    "verify:all": "npm run sync:hooks:check && npm run eval:ucr:qualification:verify && npm run verify:clients && npm run verify:certification && npm run verify:harvest && npm run verify:ucr && npm run verify:ucr:study-design && npm run verify:live-graph && npm run verify:ui && npm run verify:interactions && npm run verify:install",
    "verify:interactions": "node src/scripts/verify-wiki-interactions.mjs",
    "wiki:census": "node src/scripts/wiki-census.mjs",
    "dashboard:verify-live": "node src/scripts/verify-live-dashboard.mjs",
    "dashboard:attribution-smoke": "node src/scripts/run-dashboard-attribution-smoke.mjs",
    "dashboard:audit-savings": "node src/scripts/audit-token-savings.mjs",
    "explore:wiki": "node src/scripts/explore-wiki.mjs",
    "bench:tools": "node bench/tools/reduction.mjs",
    "bench:tools:check": "node bench/tools/reduction.check.mjs",
    "bench:build": "npm run bench:pack && docker build -f bench/thol/Dockerfile -t thol-rig:local bench/",
    "bench:screen": "bash bench/thol/run-campaign.sh",
    "bench:confirm": "REPS=3 bash bench/thol/run-campaign.sh",
    "bench:debug-loop": "node bench/debug-loop/run.mjs",
    "bench:agents": "node bench/agents/ab.mjs",
    "bench:field": "node bench/field/report.mjs",
    "bench:pack": "node src/scripts/bench-pack.mjs",
    "verify:onnx": "node src/scripts/verify-onnx-adapter.mjs",
    "proxy": "node dist/proxy/cli.js",
    "bench:screen:knowledge": "bash bench/thol/screen-knowledge.sh",
    "verify:install": "node src/scripts/verify-fresh-install.mjs",
    "bench:must-win": "node bench/compression/must-win.check.mjs",
    "bench:instruments": "node bench/compression/instrument-roster.check.mjs && node bench/compression/identifiers.check.mjs && node bench/compression/currency.check.mjs && node bench/compression/retention.check.mjs && node bench/compression/retention-floor.check.mjs && node bench/compression/conservation.check.mjs && node bench/compression/hermetic.check.mjs && node bench/compression/input-parity.check.mjs && node bench/compression/arm-selection.check.mjs && node bench/compression/load-witness.check.mjs && node bench/compression/machine-load.check.mjs && node bench/compression/store-resolution.check.mjs && node bench/compression/chunk-merge.check.mjs && node bench/compression/offload.check.mjs && node bench/compression/cost-model.check.mjs && node bench/compression/turn-lever.check.mjs && node bench/compression/speed-verdict.check.mjs && node bench/compression/replicate-agreement.check.mjs && node bench/compression/ratchet.check.mjs && node bench/compression/store-effect.check.mjs && node bench/compression/store-pair.check.mjs && node bench/compression/reproducibility.check.mjs && node bench/compression/competitor-health.check.mjs && node bench/compression/fetch-latency.check.mjs && node bench/subscription/base-context.check.mjs && node bench/subscription/cost-split.check.mjs && node bench/subscription/calibrate.check.mjs",
    "bench:known-answer": "node bench/compression/known-answer/capture.check.mjs",
    "bench:known-answer:scorer": "node bench/compression/known-answer/scorer.check.mjs",
    "bench:known-answer:mutants": "node bench/compression/known-answer/mutants.mjs",
    "bench:cost-model:check": "node bench/compression/cost-model.check.mjs",
    "bench:ledger:provenance": "node bench/ledger/verify-provenance.mjs",
    "bench:subscription:observe": "node bench/subscription/observe.mjs",
    "bench:subscription:calibrate": "node bench/subscription/calibrate.mjs",
    "bench:subscription:check": "node bench/subscription/calibrate.check.mjs",
    "bench:subscription:split": "node bench/subscription/cost-split.mjs",
    "bench:subscription:split:check": "node bench/subscription/cost-split.check.mjs",
    "bench:speed-verdict:check": "node bench/compression/speed-verdict.check.mjs"
  },
