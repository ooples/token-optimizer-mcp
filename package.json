{
  "name": "@ooples/token-optimizer-mcp",
  "version": "7.10.0",
  "mcpName": "io.github.ooples/token-optimizer-mcp",
  "description": "91.5% fewer tokens on tool output on Headroom's own benchmark, where Headroom removes 61.4%. Separately, the same SWE-bench tasks resolved at 0.71x the cost of plain Claude Code. Plus memory across sessions and subscription quota pacing. Claude Code, Codex, Copilot, Gemini and 12 more. Local, MIT.",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "bin": {
    "token-optimizer-mcp": "./dist/server/index.js",
    "token-optimizer-daemon": "./dist/server/daemon.js",
    "token-optimizer-install": "./src/scripts/install-cli.mjs",
    "token-optimizer-install-client": "./src/scripts/install-client-hooks.mjs",
    "token-optimizer-uninstall": "./src/scripts/uninstall.mjs",
    "token-optimizer-doctor": "./src/scripts/doctor.mjs",
    "token-optimizer-storage": "./src/scripts/storage.mjs",
    "token-optimizer-learn": "./dist/learn/cli.js",
    "token-optimizer-update": "./dist/update/cli.js",
    "token-optimizer-rollout": "./dist/rollout/cli.js",
    "token-optimizer-inspect": "./dist/inspect/cli.js",
    "token-optimizer-savings": "./dist/savings/cli.js",
    "token-optimizer-diagnostics": "./src/scripts/export-diagnostics.mjs",
    "token-optimizer-proxy": "./dist/proxy/cli.js",
    "token-optimizer-run": "./src/scripts/run-client.mjs",
    "token-optimizer-route": "./src/scripts/route-client.mjs",
    "token-optimizer-learned": "./src/scripts/learned.mjs",
    "token-optimizer-statusline": "./src/scripts/statusline-tap.mjs",
    "token-optimizer-agent-brief": "./src/scripts/agent-brief.mjs"
  },
  "files": [
    "dist/**/*",
    "src/cli-wrapper.mjs",
    "hooks/hooks.json",
    "gemini-extension.json",
    "src/install-hooks.ps1",
    "src/install-hooks.sh",
    "README.md",
    "LICENSE",
    "docs/CHANGELOG.md",
    "src/hooks-core/**/*",
    "src/ucr/**/*",
    "src/schemas/**/*",
    "src/evals/ucr/**/*",
    "src/integrations/**/*",
    "!src/integrations/**/lib/**",
    "src/plugin/**/*",
    "src/scripts/**/*",
    "!**/logs/**",
    "!**/*.log",
    "!**/.cache/**",
    "!**/.token-optimizer/**",
    "!**/*.db",
    "!**/*.db-*",
    "!**/*.sqlite",
    "!**/*.sqlite-*",
    "!**/*.sqlite3",
    "!**/*.sqlite3-*",
    "!**/*.tmp",
    "!**/*.temp",
    "!**/.token-optimizer-edit-*.lock",
    "!**/.env",
    "!**/.env.*"
  ],
  "scripts": {
    "postinstall": "node src/scripts/postinstall.cjs",
    "checksums": "node src/scripts/checksums.mjs",
    "screenshots": "node src/scripts/capture-screenshots.mjs",
    "uninstall-hooks": "node src/scripts/uninstall.mjs",
    "doctor": "node src/scripts/doctor.mjs",
    "learn": "node dist/learn/cli.js",
    "diagnostics": "node src/scripts/export-diagnostics.mjs",
    "projects:discover": "node src/scripts/discover-project-graphs.mjs",
    "build": "tsc -p src && npm run copy:assets",
    "copy:assets": "node src/scripts/copy-assets.mjs",
    "start": "node dist/server/index.js",
    "dev": "tsc -p src --watch",
    "mutation:run": "stryker run config/stryker.config.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js --watch",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js --ci --coverage --maxWorkers=2",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js tests/integration",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js tests/unit",
    "test:benchmark": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config config/jest.config.js tests/benchmarks",
    "dashboard": "node dist/server/web-server.js",
    "dashboard:dev": "tsc -p config/tsconfig.dashboard.json && npm run copy:assets && node dist/server/web-server.js",
    "dashboard:build": "tsc -p config/tsconfig.dashboard.json && npm run copy:assets",
    "lint": "eslint -c config/eslint.config.js --suppressions-location config/eslint-suppressions.json src tests",
    "lint:fix": "eslint -c config/eslint.config.js --suppressions-location config/eslint-suppressions.json src tests --fix",
