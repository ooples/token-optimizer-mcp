.ambiance-mcp-*.lock

# Temporary directories
${HOME}/

# Wiki graph: per-project agent knowledge, local by default (docs/WIKI_GRAPH.md)
.token-optimizer/

# Playwright UI verification output
artifacts/

# Hostile fixtures generated by scripts/seed-edge-cases.mjs
edge-src/
CHECKSUMS.sha256

# smart_edit backups from older installed builds (current versions write to ~/.token-optimizer-backups)
*.bak

# Benchmark timings: rewritten by every `npm test` run and read by no code, so
# tracking it meant each run left ~234 lines of machine-specific noise in the
# working tree. Kept locally for the across-run comparison tests/README.md
# describes -- one machine's numbers are not a shared artifact.
tests/benchmarks/results.json

# Local tool and runtime artifacts. Untracked but NOT ignored, which is how a
# `git add -A` swept 7 Playwright page snapshots and a dashboard session file into
# a release-pipeline PR. Ignored so the next one cannot.
.playwright-mcp/
data/sessions.json

# Mutation testing (Stryker). The temp tree and the JSON report are build
# output; the incremental file is a cache that makes a nightly run resumable.
.stryker-tmp/
reports/mutation/

# debug-loop harness recovery copy, written only while a run is in flight
bench/debug-loop/.source-recovery
