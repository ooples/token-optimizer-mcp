*.sqlite3

# Claude configuration (contains secrets)
.claude/

# ...except a competitor's captured scaffold, which is fixture DATA rather than
# this repository's own Claude configuration and contains no secrets.
#
# WITHOUT THIS THE ARM MEASURES AN INERT OPPONENT. The rule above matched
# `.claude/` at any depth, so `git add bench/ledger/competitors` committed the
# rules file and dropped all twelve hooks -- 5 of 20 files -- without saying so.
# A competitor arm whose hooks are missing still runs, still scores, and loses
# to us for a reason that has nothing to do with their product.
!bench/ledger/competitors/**/.claude/
!bench/ledger/competitors/**/.claude/**

# MCP registry tokens (secrets)
.mcpregistry_github_token
.mcpregistry_registry_token

# Local MCP server config at the repo root — may contain project secrets
# (Supabase/Postgres tokens etc.). MUST NOT be committed. A committed copy
# previously leaked credentials to the public repo; keep this local-only.
# Anchored to the root so plugin MCP manifests (plugin/.mcp.json,
# integrations/**/.mcp.json — npx-only, no secrets) can still be tracked.
/.mcp.json
worktrees/
 
# Local development configs and logs
.codex/
logs/

# Report and investigation files (per CLAUDE.md - never create these)
*REPORT.md
*-REPORT.md
*_REPORT.md
AGENT_*.md
*-FINDINGS.md
*_FINDINGS.md
*INVESTIGATION.md
*-INVESTIGATION.md
*ANALYSIS.md
*-ANALYSIS.md
*_ANALYSIS.md
*-plan.md
*_PLAN.md
FIX_PLAN.md
SUMMARY.md
*_SUMMARY.md

